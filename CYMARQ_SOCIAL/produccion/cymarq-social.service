[Unit]
Description=CYMARQ SOCIAL — motor de publicaciones programadas
Documentation=file:///home/celassor/cymarq-web/CYMARQ_SOCIAL/README.md
# La red tiene que estar arriba: el motor consulta Meta y descarga la imagen.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=celassor
Group=celassor
WorkingDirectory=/home/celassor/cymarq-web/CYMARQ_SOCIAL

# El reloj interno del sistema es UTC; la logica usa America/Bogota de forma
# explicita. Esto solo afecta a como se ven las marcas de tiempo en el diario.
Environment=TZ=America/Bogota
Environment=PYTHONUNBUFFERED=1

# Se ejecuta el ciclo completo: scheduler + motor. El motor comprueba por su
# cuenta el entorno, el gate y las autorizaciones; esta unidad no decide nada
# sobre si se publica o no.
ExecStartPre=/bin/mkdir -p /home/celassor/cymarq-web/CYMARQ_SOCIAL/produccion/logs
ExecStart=/home/celassor/cymarq-web/CYMARQ_SOCIAL/produccion/ciclo.sh

# Una ejecucion no deberia pasar de unos minutos ni con reintentos de red.
TimeoutStartSec=900

# Sin reinicio automatico: si un ciclo falla, el siguiente disparo del timer lo
# volvera a intentar. Reintentar en bucle contra Meta no arregla nada y si
# puede empeorarlo.
Restart=no

# --- Endurecimiento ---
# El servicio solo necesita leer el repositorio y escribir su estado.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# El guion `-` hace la ruta opcional: sin el, systemd se niega a arrancar si
# alguna todavia no existe, que es justo lo que pasa en una instalacion nueva
# antes del primer ciclo (los diarios se crean al publicar).
ReadWritePaths=-/home/celassor/cymarq-web/CYMARQ_SOCIAL/CONFIG
ReadWritePaths=-/home/celassor/cymarq-web/CYMARQ_SOCIAL/PENDIENTES
ReadWritePaths=-/home/celassor/cymarq-web/CYMARQ_SOCIAL/PUBLICADOS
ReadWritePaths=-/home/celassor/cymarq-web/CYMARQ_SOCIAL/produccion/logs
ReadWritePaths=-/home/celassor/cymarq-web/.instagram-publish-state.json
ReadWritePaths=-/home/celassor/cymarq-web/.facebook-publish-state.json
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
