# =====================================================================
#  ESTE REPOSITORIO ES PUBLICO.
#  Cualquier archivo que entre aquí queda accesible para todo el mundo, de
#  forma permanente y también en el historial. Ante la duda, se ignora.
#  Nunca uses `git add -A`: añade siempre archivos concretos.
# =====================================================================

# ---------- Web (Next.js) ----------
node_modules
.next
out
.DS_Store
*.log

# ---------- Credenciales ----------
.env*
# La plantilla sin valores sí se versiona
!.env.example
*.env
credenciales.json
credentials.json
token*.json
*token*.txt
*.pem
*.key
*.p12
secretos/

# ---------- Diarios de publicación ----------
# Ids de contenedor, de media y de post. No llevan credenciales, pero son
# estado de ejecución de esta máquina y no deben viajar.
.instagram-publish-state.json
.facebook-publish-state.json

# =====================================================================
#  CYMARQ_SOCIAL — sistema local de contenido
#  Se versiona SOLO el código. Ni el material de los clientes ni nada
#  generado localmente.
# =====================================================================

# ---------- Material original de los proyectos ----------
# Renders, planos, PDF y DOCX: propiedad de los clientes. Jamás.
# Los patrones van sin ruta a propósito: así protegen la carpeta esté
# donde esté, no solo en su ubicación actual.
PROYECTOS/
PENDIENTES/
PUBLICADOS/

# ---------- Datos locales generados ----------
# Sin ruta a propósito. Un patrón que lleva barra queda anclado a la carpeta
# de este .gitignore, así que `CONFIG/historial...` NO cubriría
# `CYMARQ_SOCIAL/CONFIG/historial...`. Por nombre sí, esté donde esté.
inventario_contenido.json
historial_publicaciones.json
perfiles_proyectos.json
imagenes_publicas.json
**/CONFIG/secretos*
**/CONFIG/*token*
**/CONFIG/*credencial*

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Sistema operativo / editores ----------
Thumbs.db
desktop.ini
*.swp
.vscode/
.idea/
.claude/settings.local.json

# ---------- Temporales ----------
*.tmp
.tmp_*

# Locks de ejecucion del motor. Estado de runtime de esta maquina.
**/CONFIG/locks/
