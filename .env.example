# Integración de Instagram (app Meta "CYMARQ Social" / "CYMARQ Social-IG")
#
# Plantilla: SOLO nombres de variables, nunca valores reales.
# Copia este archivo a `.env.local` para pruebas locales (`.env*` está ignorado
# por git). En producción, estas variables se configuran en el panel de
# Cloudflare Pages → Settings → Variables and Secrets, como tipo "Secret".
#
# Ninguna de estas variables debe llevar el prefijo NEXT_PUBLIC_: son de
# servidor y nunca deben llegar al navegador.

# Cadena secreta y larga que se escribe también en Meta → Webhooks →
# "Token de verificación". Solo se usa en el handshake GET.
INSTAGRAM_VERIFY_TOKEN=

# App Secret con el que Meta firma la cabecera X-Hub-Signature-256 de cada POST.
# Se valida como HMAC-SHA256 sobre los bytes crudos del cuerpo. Solo servidor.
INSTAGRAM_APP_SECRET=

# Access Token de la cuenta profesional @cymarq.obras (IG User ID
# 17841466818245536). Se usará para responder mensajes vía graph.instagram.com.
INSTAGRAM_ACCESS_TOKEN=

# Token de publicación de contenido. Es un token DISTINTO del anterior: se
# genera en Meta → Instagram → API setup DESPUÉS de añadir el permiso
# instagram_business_content_publish, porque los permisos quedan grabados en el
# token en el momento de generarlo. Válido 60 días, renovable con
# /refresh_access_token. Solo lo usan los scripts locales de publicación; el
# webhook no lo lee.
INSTAGRAM_PUBLISH_TOKEN=

# --- Página de Facebook "Cymarq" -------------------------------------
#
# Integración independiente de la de Instagram: otro host
# (graph.facebook.com), otro token y otro flujo. Publicar una foto nativa es
# una sola llamada a POST /<PAGE_ID>/photos; no hay contenedores.

# Identificador numérico de la Página. No es secreto, pero se configura junto
# al token para no dejarlo incrustado en el código.
FACEBOOK_PAGE_ID=

# Page Access Token de la Página Cymarq. Permisos ya concedidos:
# pages_manage_posts, pages_read_engagement, pages_show_list.
# Solo lo usan los scripts locales de publicación.
FACEBOOK_PAGE_ACCESS_TOKEN=
