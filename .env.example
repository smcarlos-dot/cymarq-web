# Integración de Instagram (app Meta "CYMARQ Social" / "CYMARQ Social-IG")
#
# Plantilla: SOLO nombres de variables, nunca valores reales.
# Copia este archivo a `.env.local` para pruebas locales (`.env*` está ignorado
# por git). En producción, estas variables se configuran en el panel de
# Cloudflare Pages → Settings → Variables and Secrets, como tipo "Secret".
#
# Ninguna de estas variables debe llevar el prefijo NEXT_PUBLIC_: son de
# servidor y nunca deben llegar al navegador.

# Cadena secreta y larga que se escribe también en Meta → Webhooks →
# "Token de verificación". Solo se usa en el handshake GET.
INSTAGRAM_VERIFY_TOKEN=

# App Secret con el que Meta firma la cabecera X-Hub-Signature-256 de cada POST.
# Solo servidor.
#
# OJO: el panel de Meta expone DOS claves distintas y NO intercambiables:
#   A) Configuración → Básica → "Clave secreta de la app"            (CYMARQ Social)
#   B) Instagram → Configuración de la API → "Clave secreta de la
#      app de Instagram"                                             (CYMARQ Social-IG)
# Candidato principal.
INSTAGRAM_APP_SECRET=

# Segundo candidato a App Secret. Permite cargar las dos claves a la vez y que
# el diagnóstico determine cuál produce el HMAC correcto, en lugar de ir
# cambiando el valor a ciegas. Opcional: retirar cuando se sepa cuál es la buena.
INSTAGRAM_APP_SECRET_ALT=

# Cualquier valor no vacío activa los logs de diagnóstico de la firma
# (presencia, longitud y huella irreversible de cada candidato; nunca el valor).
# Temporal: borrar esta variable cuando el webhook quede validado.
INSTAGRAM_WEBHOOK_DEBUG=

# Access Token de la cuenta profesional @cymarq_obras (IG User ID
# 17841466818245536). Se usará para responder mensajes vía graph.instagram.com.
INSTAGRAM_ACCESS_TOKEN=
